# Copy to .env.local. Supabase values come from `npx supabase status` (local stack defaults shown).

# Supabase API URL ("API_URL" in `npx supabase status`). Public: used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key ("PUBLISHABLE_KEY" in `npx supabase status`). Public: safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret key ("SECRET_KEY" in `npx supabase status`). Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<SECRET_KEY from npx supabase status>

# Postgres connection used by Prisma at runtime ("DB_URL" in `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct (non-pooled) Postgres connection used by the Prisma CLI (db pull). Same as DB_URL locally.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared secret for the payment gateway's x_signature HMAC. Chosen by us and given to the gateway;
# this local value matches the brief's test vector. Use a long random value anywhere else.
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
