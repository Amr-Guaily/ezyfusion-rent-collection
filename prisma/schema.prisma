// Introspected with `npx prisma db pull --force` after `npx supabase db reset`.
// supabase/migrations/*.sql is the source of truth (CHECKs, exclusion constraint, RLS and
// triggers live only there). Do not edit models by hand; re-run db pull instead.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_log {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String        @db.Uuid
  actor_id      String?       @db.Uuid
  action        String
  entity_id     String
  details       Json          @default("{}")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([org_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gateway_bills {
  id             String              @id
  org_id         String              @db.Uuid
  lease_id       String              @db.Uuid
  amount_sen     BigInt
  status         gateway_bill_status @default(pending)
  transaction_id String?
  paid_at        DateTime?           @db.Timestamptz(6)
  created_by     String              @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime            @default(now()) @db.Timestamptz(6)
  leases         leases              @relation(fields: [lease_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  payments       payments?

  @@unique([id, org_id])
  @@index([lease_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String                @db.Uuid
  lease_id            String                @db.Uuid
  kind                invoice_kind
  period_index        Int?
  period_start        DateTime?             @db.Date
  period_end          DateTime?             @db.Date
  due_date            DateTime              @db.Date
  amount_sen          BigInt
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  leases              leases                @relation(fields: [lease_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  payment_allocations payment_allocations[]

  @@unique([id, org_id])
  @@unique([lease_id, period_index])
  @@index([lease_id, due_date])
  @@index([org_id, due_date])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leases {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id           String          @db.Uuid
  unit_id          String          @db.Uuid
  tenant_id        String          @db.Uuid
  start_date       DateTime        @db.Date
  end_date         DateTime        @db.Date
  monthly_rent_sen BigInt
  deposit_sen      BigInt
  created_by       String          @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  gateway_bills    gateway_bills[]
  invoices         invoices[]
  organizations    organizations   @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants          tenants         @relation(fields: [tenant_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  units            units           @relation(fields: [unit_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  payments         payments[]

  @@unique([id, org_id])
  @@index([org_id])
  @@index([tenant_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model memberships {
  user_id       String          @id @db.Uuid
  org_id        String          @db.Uuid
  role          membership_role
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  organizations organizations   @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([org_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organizations {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  audit_log   audit_log[]
  leases      leases[]
  memberships memberships[]
  tenants     tenants[]
  units       units[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payment_allocations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String   @db.Uuid
  payment_id String   @db.Uuid
  invoice_id String   @db.Uuid
  amount_sen BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  invoices   invoices @relation(fields: [invoice_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  payments   payments @relation(fields: [payment_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([payment_id, invoice_id])
  @@index([invoice_id])
  @@index([org_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String                @db.Uuid
  lease_id            String                @db.Uuid
  amount_sen          BigInt
  unapplied_sen       BigInt                @default(0)
  method              payment_method
  status              payment_status
  received_at         DateTime              @db.Timestamptz(6)
  slip_path           String?               @unique
  gateway_bill_id     String?               @unique
  recorded_by         String?               @db.Uuid
  reviewed_by         String?               @db.Uuid
  reviewed_at         DateTime?             @db.Timestamptz(6)
  review_reason       String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  payment_allocations payment_allocations[]
  gateway_bills       gateway_bills?        @relation(fields: [gateway_bill_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)
  leases              leases                @relation(fields: [lease_id, org_id], references: [id, org_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([gateway_bill_id, org_id])
  @@unique([id, org_id])
  @@index([lease_id, status])
  @@index([org_id, status, received_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tenants {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String        @db.Uuid
  user_id       String?       @db.Uuid
  full_name     String
  email         String
  phone         String?
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  leases        leases[]
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, org_id])
  @@unique([org_id, user_id])
  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model units {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String        @db.Uuid
  name          String
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  leases        leases[]
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, org_id])
  @@unique([org_id, name])
}

enum gateway_bill_status {
  pending
  paid
  failed
}

enum invoice_kind {
  deposit
  rent
}

enum membership_role {
  manager
  staff
}

enum payment_method {
  cash
  bank_transfer
  online
}

enum payment_status {
  pending_verification
  approved
  rejected
  voided
}
